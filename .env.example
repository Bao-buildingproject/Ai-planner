# Sao chép file này thành .env.local khi chạy trên máy của bạn.
# KHÔNG commit file .env.local.

# Bắt buộc: chuỗi kết nối PostgreSQL (Neon hoặc Postgres trên máy).
DATABASE_URL=postgres://planner:planner@localhost:5432/ai_planner_dev
# Không bắt buộc: kết nối trực tiếp (không qua pooler) để chạy migration. Neon tự tạo biến này.
# DATABASE_URL_UNPOOLED=

# Không bắt buộc: đặt mã mời thì người mới phải nhập đúng mã mới đăng ký được.
# Để trống = ai có đường link cũng tự đăng ký được.
# INVITE_CODE=

# Chỉ khi chạy bản production (npm start) trên http://localhost bằng Safari: cho phép cookie không Secure.
# INSECURE_COOKIES=1
